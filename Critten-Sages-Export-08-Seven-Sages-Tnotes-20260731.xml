        <note type="tnote" n="54">803<space rend="indent1"/><p><hi rend="italic">forth goth</hi>.
              <hi rend="bold">A</hi>: <hi rend="italic">goþ forþ</hi>.</p></note>
        <note type="tnote" n="55">804<space rend="indent1"/><p><hi rend="italic">and</hi>. <hi
