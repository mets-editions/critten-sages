        <note type="tnote" n="42">625<space rend="indent1"/><p><hi rend="italic">Ich</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">Iich</hi>.</p></note>
        <note type="tnote" n="43">628<space rend="indent1"/><p><hi rend="italic">ferste</hi>. <hi
              rend="italic">r</hi> added above in <hi rend="bold">A</hi>.</p></note>
        <note type="tnote" n="44">647<space rend="indent1"/><p><hi rend="italic">deciple</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">deciphe</hi>.</p></note>
        <note type="tnote" n="45">655<space rend="indent1"/><p>There is an in initial paraph mark in
            blue ink.</p></note>
        <note type="tnote" n="46">679<space rend="indent1"/><p><hi rend="italic">hale</hi>. Erasure
            of one letter or space between <hi rend="italic">a</hi> and <hi rend="italic">l</hi> in
            this word in <hi rend="bold">A</hi>.</p></note>
        <note type="tnote" n="47">714<space rend="indent1"/><p><hi rend="italic">soukeying</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">souke ȝing</hi>.</p></note>
        <note type="tnote" n="48">718<space rend="indent1"/><p><hi rend="italic">and</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">an</hi>.</p></note>
        <note type="tnote" n="49">720<space rend="indent1"/><p><hi rend="italic">Ther</hi>. <hi
