        <note type="tnote" n="40">590<space rend="indent1"/><p><hi rend="italic">iket</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">ikest</hi>.</p></note>
        <note type="tnote" n="41">604<space rend="indent1"/><p><hi rend="italic">Hit is so</hi>. <hi
