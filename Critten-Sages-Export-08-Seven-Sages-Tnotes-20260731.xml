        <note type="tnote" n="21">261<space rend="indent1"/><p><hi rend="italic">sikerli</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">sikeli</hi>.</p></note>
        <note type="tnote" n="22">266<space rend="indent1"/><p><hi rend="italic">fram me hedde</hi>.
              <hi rend="bold">A</hi>: <hi rend="italic">fram hedde</hi>.</p></note>
        <note type="tnote" n="23">272<space rend="indent1"/><p><hi rend="italic">ending</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">eding</hi>.</p></note>
        <note type="tnote" n="24">286<space rend="indent1"/><p><hi rend="italic">thousend</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">þounsed</hi>.</p></note>
        <note type="tnote" n="25">288–92<space rend="indent1"/><p>There is a mark or smudge that
            extends across lines 288–92 and partially obscures the words <hi rend="italic">to</hi>,
              <hi rend="italic">toforn</hi>, and <hi rend="italic">with his</hi>.</p></note>
        <note type="tnote" n="26">331<space rend="indent1"/><p><hi rend="italic">Themperour</hi>.
              <hi rend="bold">A</hi>: <hi rend="italic">Þenperour</hi>.</p></note>
        <note type="tnote" n="27">356<space rend="indent1"/><p><hi rend="italic">The</hi>. <hi
              rend="bold">A</hi>: <hi rend="italic">Þ</hi>.</p></note>
        <note type="tnote" n="28">379<space rend="indent1"/><p><hi rend="italic">wald with wit</hi>.
              <hi rend="bold">A</hi>: <hi rend="italic">wald wit</hi>.</p></note>
        <note type="tnote" n="29">383<space rend="indent1"/><p><hi rend="italic">hit</hi>. <hi
